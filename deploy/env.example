# Secret AI settings: the same names and values as in Render → Environment.
# Paste each value after "=" (no quotes, no spaces). Empty lines are fine — that feature just stays off.
TELEGRAM_TOKEN=
OWNER_ID=
ALLOWED_USERS=
DATABASE_URL=
ENCRYPTION_KEY=
# Optional message restoration: upload the encrypted file created with tools/guard_login.py.
# The helper must use this ENCRYPTION_KEY (or TELEGRAM_TOKEN when ENCRYPTION_KEY is empty).
# After restart, the supergroup owner opts in with /guard on; /guard off disables it.
GUARD_ENABLED=0
GUARD_SESSION_FILE=.guard-session.enc
OPENAI_API_KEY=
# Optional Oxion AI: paused by default; set OXIONAI_ENABLED=1 to opt in.
OXIONAI_ENABLED=0
OXIONAI_API_KEY=
OXIONAI_BASE=https://www.oxionai.com/v1
OXIONAI_MODELS=claude-sonnet-5
# New chat gateway: keep the key only in the server .env, never in GitHub.
# Only Grok 4.7 Fast is enabled, if confirmed by the gateway catalog.
REFORMBOSS_API_KEY=
REFORMBOSS_BASE=https://api.reformboss.com/v1
ABACUS_API_KEY=
ANYMODEL_API_KEY=
CHAT_REASONING_EFFORT=low
GEMINI_API_KEY=
FAL_KEY=
HF_TOKEN=
FISH_API_KEY=
AUDD_API_TOKEN=
BRAND_EMOJI_ID=
# Private GitHub repo: a fine-grained token (only this repo, Contents: Read-only) so the bot can still update itself.
GITHUB_REPO_TOKEN=
# Anything else you had on Render (CHAT_MODEL, ABACUS_MODEL, PIPEDREAM_*, GITHUB_*, KLING_*, ...) — add it below the same way.
