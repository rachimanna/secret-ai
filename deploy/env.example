# Secret AI settings: the same names and values as in Render → Environment.
# Paste each value after "=" (no quotes, no spaces). Empty lines are fine — that feature just stays off.
TELEGRAM_TOKEN=
OWNER_ID=
ALLOWED_USERS=
DATABASE_URL=
ENCRYPTION_KEY=
OPENAI_API_KEY=
# Optional Oxion AI trial: when this key is set, ONLY these Oxion chat models are offered.
# Remove OXIONAI_API_KEY to restore the previous chat gateways. Other media keys remain configured.
OXIONAI_API_KEY=
OXIONAI_BASE=https://www.oxionai.com/v1
OXIONAI_MODELS=claude-sonnet-5
# New chat gateway: keep the key only in the server .env, never in GitHub.
# Only Grok 4.7 Fast is enabled, if confirmed by the gateway catalog.
REFORMBOSS_API_KEY=
REFORMBOSS_BASE=https://api.reformboss.com/v1
ABACUS_API_KEY=
ANYMODEL_API_KEY=
CHAT_REASONING_EFFORT=low
GEMINI_API_KEY=
FAL_KEY=
HF_TOKEN=
FISH_API_KEY=
AUDD_API_TOKEN=
BRAND_EMOJI_ID=
# Anything else you had on Render (CHAT_MODEL, ABACUS_MODEL, PIPEDREAM_*, GITHUB_*, KLING_*, ...) — add it below the same way.
